# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# FastEmbed / local embedding model downloads
.fastembed_cache/
*.onnx
*.onnx_data
*.safetensors
*.gguf
# Bundled embedding model (compiled into the binary via include_bytes!, not a runtime download)
!assets/embedding-model/*.onnx

# Local vector store (created at runtime under app data; ignore if dropped here)
nest-vectors.db
nest-vectors.db-*

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nest",
  "version": "0.1.4",
  "identifier": "com.cyborgoat.nest.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nest",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#f4efe7"
      }
    ],
    "security": {
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/windows-icon.ico",
        "uninstallerIcon": "icons/windows-icon.ico",
        "headerImage": "windows/nsis/installer-header.bmp",
        "uninstallerHeaderImage": "windows/nsis/installer-header.bmp",
        "sidebarImage": "windows/nsis/installer-sidebar.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# Listen interface (use 0.0.0.0 for cloud / reverse-proxy ingress)
HOST=0.0.0.0
# HTTP listen port
PORT=8787
# Absolute or relative (to apps/hub) path to the pack registry root
REGISTRY_PATH=../../examples/knowledge-packs
# Verbose Hub logs: true / 1 / yes / on
DEBUG_MODE=false
# CORS: * = allow all, or comma-separated origins
CORS_ORIGIN=*
# Suggested client download timeout (ms); desktop Hub downloads use 120000
DOWNLOAD_TIMEOUT_MS=120000
# Hub control-plane SQLite database and pending upload storage
DATABASE_PATH=./data/hub.sqlite3
STAGING_PATH=./data/staging
MAX_PACK_UPLOAD_BYTES=104857600
# Required: generate a unique value of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
MIN_PASSWORD_LENGTH=8
# Optional: adopt or create the permanent, immutable superuser on first startup.
# The managed marker remains in SQLite after these variables are removed.
# Remove the password after first startup so it is not kept in plaintext config.
# Existing development accounts created before the scrypt migration must be reset.
# SUPERUSER_ID=admin
# SUPERUSER_PASSWORD=replace-with-a-strong-password
# SUPERUSER_NAME=Administrator
# Required for the admin dashboard's "reset password" action: the password an
# admin/superuser resets a user's account to. Unrelated to the superuser
# bootstrap above. Must be at least MIN_PASSWORD_LENGTH characters.
# DEFAULT_RESET_PASSWORD=replace-with-a-strong-default-password

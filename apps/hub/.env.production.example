# Production example — copy to `.env` on the host (Nest loads `.env` from apps/hub).
# Do not commit real production secrets; this file is a template only.

NODE_ENV=production

# Listen on all interfaces so LAN clients can reach Hub
HOST=0.0.0.0
PORT=8787

# Absolute path to the pack registry on the host (PyPI-style {id}/{semver}/)
REGISTRY_PATH=/var/lib/nest-hub/registry

# Keep verbose zip/list traces off in production
DEBUG_MODE=false

# Prefer explicit origins over * for internal deploys (comma-separated)
# Example: https://desktop.example.internal or leave * only for trusted LANs
CORS_ORIGIN=*

# Documented client download timeout hint (ms); desktop Hub downloads use 120000
DOWNLOAD_TIMEOUT_MS=120000

# Persistent control database and temporary publishing-review uploads
DATABASE_PATH=/var/lib/nest-hub/hub.sqlite3
STAGING_PATH=/var/lib/nest-hub/staging
MAX_PACK_UPLOAD_BYTES=104857600

# Generate a unique secret of at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
MIN_PASSWORD_LENGTH=12

# Adopt or create the permanent superuser. Its managed marker persists in SQLite.
# Remove SUPERUSER_PASSWORD after the account exists.
SUPERUSER_ID=admin
SUPERUSER_PASSWORD=replace-with-a-strong-password
SUPERUSER_NAME=Administrator
